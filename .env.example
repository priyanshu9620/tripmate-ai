# Copy to .env and fill in. Nothing here is required to run with LLM_PROVIDER=fake.

# ---- LLM (pick one block; switching provider = editing these lines, no code change) ----
LLM_PROVIDER=google_genai        # fake | google_genai | anthropic | groq | ollama
LLM_MODEL=gemini-3.5-flash-lite
GOOGLE_API_KEY=

# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-5-5
# ANTHROPIC_API_KEY=

# LLM_PROVIDER=groq
# LLM_MODEL=openai/gpt-oss-120b
# GROQ_API_KEY=

# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:14b

# ---- storage ----
DATABASE_URL=postgresql://tm:tm@localhost:5433/tripmate

# ---- tools: offline (fixtures, default) | live (Open-Meteo / Nominatim / Overpass) ----
TOOLS_MODE=offline

# ---- tracing (optional; see docs/GUIDE.md) ----
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=tripmate-ai
